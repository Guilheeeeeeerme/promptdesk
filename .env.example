# Docker Compose / shared defaults
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support

# API inside Compose (service DNS names)
DATABASE_URL=postgresql://support:support@postgres:5432/support?schema=public
REDIS_URL=redis://redis:6379
SESSION_TTL_SECONDS=86400
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
PORT=3000

# Web build-time API prefix (nginx proxies /api → api:3000)
VITE_API_URL=/api
