# Docker Compose / shared defaults
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support

# Optional chat Postgres overrides (defaults mirror core creds, DB name support_chat)
POSTGRES_CHAT_USER=support
POSTGRES_CHAT_PASSWORD=support
POSTGRES_CHAT_DB=support_chat

# API / worker inside Compose (service DNS on dmz_internal)
DATABASE_URL=postgresql://support:support@postgres:5432/support?schema=public
CHAT_DATABASE_URL=postgresql://support:support@postgres-chat:5432/support_chat?schema=public
REDIS_URL=redis://redis:6379
SESSION_TTL_SECONDS=86400
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081,http://localhost:5173,http://localhost:5174
PORT=3000

# Chat API — fair-use cap on LLM-triggering sends (per user + company, per minute)
CHAT_RATE_LIMIT_PER_MINUTE=20

# SSO allowlist for MFE return URLs after login on the main app
SSO_RETURN_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5174,http://127.0.0.1:5174

# Chat worker — Gemini required; OpenAI optional failover after Gemini rank exhausts
GEMINI_API_KEY=
# Optional override; live rank uses Redis cheapest top-3 (see ModelRankService)
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: only used when Gemini attempts/models all fail
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Optional provider order (default gemini,openai = Gemini first, OpenAI fallback);
# unknown names ignored, providers without a configured key skipped
LLM_PROVIDER_ORDER=gemini,openai
CHAT_JOB_ATTEMPTS=3
# 12 hours; refresh also runs once when chat-worker starts
MODEL_RANK_REFRESH_MS=43200000
MODEL_RANK_TOP_N=3
CHAT_WORKER_PORT=3001

# Web / Support build-time
VITE_API_URL=/apimake 
VITE_MAIN_ORIGIN=http://localhost:8080
VITE_SUPPORT_ORIGIN=http://localhost:8081
