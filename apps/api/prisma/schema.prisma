generator client {
  provider = "prisma-client-js"
}

// Core client for chat-worker (company guidelines lookups).
generator chatWorkerCore {
  provider = "prisma-client-js"
  output   = "../../chat-worker/node_modules/@prisma/core-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  root
  admin
  manager
  agent
}

model Company {
  id                 String   @id @default(cuid())
  name               String   @unique
  createdAt          DateTime @default(now())
  // Default UI locale for company users; supported: en|es|zh|hi|ar.
  // Non-null with a default so existing rows and new companies read "en".
  defaultLanguage    String   @default("en")
  guidelineText      String?
  guidelineFileName  String?
  guidelineUpdatedAt DateTime?
  users              User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}
