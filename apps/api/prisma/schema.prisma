generator client {
  provider = "prisma-client-js"
}

// Core client for chat-worker (company guidelines lookups).
generator chatWorkerCore {
  provider = "prisma-client-js"
  output   = "../../chat-worker/node_modules/@prisma/core-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  root
  admin
  manager
  agent
  owner
}

enum GuidelineValidationStatus {
  pending
  processing
  valid
  invalid
  provider_error
  cancelled
}

model Company {
  id                        String             @id @default(cuid())
  name                      String             @unique
  createdAt                 DateTime           @default(now())
  guidelineText             String?
  guidelineFileName         String?
  guidelineUpdatedAt        DateTime?
  users                     User[]
  // Denormalized pointer to the current immutable guideline version.
  currentGuidelineVersionId String?            @unique
  currentGuidelineVersion   GuidelineVersion?  @relation("CompanyCurrentGuidelineVersion", fields: [currentGuidelineVersionId], references: [id])
  versions                  GuidelineVersion[] @relation("CompanyGuidelineVersions")
}

// Immutable snapshot of a company guideline upload. History is never deleted.
model GuidelineVersion {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation("CompanyGuidelineVersions", fields: [companyId], references: [id])
  currentCompany Company? @relation("CompanyCurrentGuidelineVersion")
  version        Int
  content        String
  fileName       String?
  contentHash    String
  byteSize       Int?
  status         GuidelineValidationStatus @default(pending)
  validationReason String?
  validationStartedAt DateTime?
  validatedAt   DateTime?
  // Soft reference to the uploading user (no relation; may dangle after user removal).
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([companyId, version])
  @@index([companyId, createdAt])
  @@index([companyId, status, version])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  locale       String?
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}
