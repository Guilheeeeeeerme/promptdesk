{
  "name": "chat-worker",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema prisma-core/schema.prisma && prisma generate --schema prisma-chat/schema.prisma",
    "test": "jest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.41.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^4.3.2",
    "openai": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@nestjs/config$": "<rootDir>/testing/nestjs-config-stub.ts"
    },
    "testEnvironment": "node"
  }
}
