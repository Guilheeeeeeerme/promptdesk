# Paste REAL values into the Dokploy Compose stack env (panel), never commit them.
# Names only here — this file is the surface map, not a source of values.
# This file also matches `.github/workflows/deploy.yml` + `deploy/compose.prod.yml`.

# --- Stack identity ---------------------------------------------------------
# Injected by CI (GIT_SHA build arg + stack env); set manually only for manual runs.
GIT_SHA=
IMAGE_TAG=production
# Optional image overrides (defaults derive from IMAGE_TAG):
API_IMAGE=ghcr.io/guilheeeeeeerme/promptdesk/api:production
CHATWORKER_IMAGE=ghcr.io/guilheeeeeeerme/promptdesk/chatworker:production

# --- Postgres (Dokploy-owned single container, TWO databases + TWO roles) ----
# PromptDesk is Hostinger-only: NEVER point these at Supabase.
POSTGRES_PASSWORD=                 # init superuser (private network only)
POSTGRES_PROMPTDESK_PASSWORD=      # role `promptdesk`  → db `promptdesk`
POSTGRES_PROMPTDESK_CHAT_PASSWORD= # role `promptdesk_chat` → db `promptdesk_chat`
DATABASE_URL=postgresql://promptdesk:@postgres:5432/promptdesk?schema=public
DATABASE_DIRECT_URL=postgresql://promptdesk:@postgres:5432/promptdesk?schema=public
CHAT_DATABASE_URL=postgresql://promptdesk_chat:@postgres:5432/promptdesk_chat?schema=public
CHAT_DATABASE_DIRECT_URL=postgresql://promptdesk_chat:@postgres:5432/promptdesk_chat?schema=public

# --- Redis (per-app container, password + noeviction) -----------------------
REDIS_PASSWORD=
# Composed in compose.prod.yml from REDIS_PASSWORD (redis://:<pass>@redis:6379)

# --- API runtime ------------------------------------------------------------
SESSION_TTL_SECONDS=86400
CORS_ORIGIN=https://app.promptdesk.ferredemo.dev,https://support.promptdesk.ferredemo.dev
SSO_RETURN_ORIGINS=https://support.promptdesk.ferredemo.dev
CHAT_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=log
NODE_ENV=production

# --- LLM / chat worker (chat-worker consumes; keys recover before wipe) ------
LLM_USE_HEADROOM=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=http://headroom:8787
LLM_PROVIDER_ORDER=gemini
# No OpenAI: retired project-wide (Infra docs/quizzeira-jev.md for the JEV note;
# PromptDesk is Gemini-only, Headroom-routed).MODEL_RANK_REFRESH_MS=43200000
MODEL_RANK_TOP_N=3
LLM_RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_BUDGET=500
CHAT_JOB_ATTEMPTS=3

# --- Migration switch -------------------------------------------------------
# Set 1 only for rollbacks (deploy/README.md SKIP_MIGRATIONS section)
SKIP_MIGRATIONS=

# --- Memory tier (see deploy/tiers/*.env) -----------------------------------
PD_API_MEM_LIMIT=640m
PD_CHATWORKER_MEM_LIMIT=640m
PD_POSTGRES_MEM_LIMIT=512m
PD_REDIS_MEM_LIMIT=128m
PD_MIGRATE_MEM_LIMIT=256m
