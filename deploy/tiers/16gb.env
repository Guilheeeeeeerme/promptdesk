# PromptDesk (api + chat-worker + own Postgres + Redis) — memory tier limits.
# Source: infra/docs/plans/2026-10-07-dokploy-rebuild.md "Memory budget".
# Loaded into the Dokploy stack env when the tier is chosen.

# Group budget (16 GB tier): PromptDesk ≤ 2000 MB.
# Arithmetic: api 640 + chatworker 640 + postgres 512 + redis 128 = 1920 MB
# (≤ 2000; migrate is one-shot at 256 and not counted while running).
PD_API_MEM_LIMIT=640m
PD_CHATWORKER_MEM_LIMIT=640m
PD_POSTGRES_MEM_LIMIT=512m
PD_REDIS_MEM_LIMIT=128m
PD_MIGRATE_MEM_LIMIT=256m
